{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "warnings": {"dev": false, "deprecated": false},
      "displayName": "Debug (Ninja + g++)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" }
  ]
}